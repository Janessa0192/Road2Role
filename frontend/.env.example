# Copy to .env.local to override. All values are optional.

# Base URL the React app uses for API calls.
# Keep it RELATIVE (default) so the session cookie and the backend's same-origin
# (CSRF) check keep working through the Vite proxy.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev/preview proxy forwards /api requests (Express backend).
BACKEND_URL=http://127.0.0.1:3000
