# Copy this file to backend/.env (it is git-ignored in most setups - never commit real keys).

# ---- Voice teacher / AI --------------------------------------------------------------------
# Optional. Without a key the voice teacher still works in "basic" mode (reads each topic's notes aloud).
# With a key it explains topics in simple English / Hindi / Hinglish and answers learners' doubts.
#
# Fast inference: Groq. Create a key at https://console.groq.com/keys
GROQ_API_KEY=
# Backup: Google Gemini. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
AI_TIMEOUT_MS=1200000
# Optional backup: Anthropic (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional overrides. Groq is selected automatically when its key is set; configured
# providers are used as backups during rate limits, outages, and temporary network errors.
# AI_PROVIDER=groq
# AI_MODEL=openai/gpt-oss-20b
# AI_TIMEOUT_MS=30000
# TEACHER_RATE_LIMIT_MAX=20        # requests per minute per IP on /api/v1/teacher/*
# TEACHER_LESSON_TTL=86400         # seconds a generated lesson is cached in memory
